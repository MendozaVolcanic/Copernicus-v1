	<title>The Andean Southern Volcanic Zone:  a review on the legacy of the latest volcanic eruptions | Romero | Andean Geology</title>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<meta name="description" content="The Andean Southern Volcanic Zone:  a review on the legacy of the latest volcanic eruptions" />
			
<meta name="keywords" content="Volcanic eruptions; Volcano monitoring; Volcanic ris; Southern Andes; Chile; Argentina" />
	
	
	<link rel="schema.DC" href="http://purl.org/dc/elements/1.1/" />

	<meta name="DC.Contributor.Sponsor" xml:lang="en" content=""/>
	<meta name="DC.Contributor.Sponsor" xml:lang="es" content=""/>
